#!/bin/sh
# ds-loop launcher for the skill. Delegates to the package entry point, which
# picks dist/cli.js in a published install and src/cli.ts in a git checkout.
#
# This used to resolve $REPO_ROOT/src/cli.ts directly. That broke the moment the
# published package stopped shipping `src` — Node cannot strip types under
# node_modules, so the distribution ships compiled JS. One entry point, no
# duplicated version logic.

set -e

BIN_DIR=$(cd "$(dirname "$0")" && pwd)
# skill/bin/ds-loop -> package root is two levels up
ROOT=$(cd "$BIN_DIR/../.." && pwd)
LAUNCHER="$ROOT/bin/ds-loop.mjs"

if [ ! -f "$LAUNCHER" ]; then
  echo "ds-loop: cannot find the launcher at $LAUNCHER" >&2
  echo "ds-loop: the skill must sit inside the ds-loop package, not beside it" >&2
  exit 1
fi

exec node "$LAUNCHER" "$@"
