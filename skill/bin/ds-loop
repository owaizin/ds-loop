#!/bin/sh
# ds-loop launcher for the skill. Delegates to the package entry point, which
# picks dist/cli.js in a published install and src/cli.ts in a git checkout.
#
# This used to resolve $REPO_ROOT/src/cli.ts directly. That broke the moment the
# published package stopped shipping `src` — Node cannot strip types under
# node_modules, so the distribution ships compiled JS. One entry point, no
# duplicated version logic.

set -e

# pwd -P, not pwd: an agent that installs skills from a central directory
# (~/.codex/skills, ~/.claude/skills) symlinks this directory, and the logical
# path then resolves two levels up from the *link*, not from the package.
BIN_DIR=$(cd "$(dirname "$0")" && pwd -P)
# skill/bin/ds-loop -> package root is two levels up
ROOT=$(cd "$BIN_DIR/../.." && pwd -P)
LAUNCHER="$ROOT/bin/ds-loop.mjs"

if [ -f "$LAUNCHER" ]; then
  exec node "$LAUNCHER" "$@"
fi

# a copied skill directory has no package around it; a normal install still does
if command -v ds-loop >/dev/null 2>&1; then
  exec ds-loop "$@"
fi

echo "ds-loop: no launcher at $LAUNCHER, and no ds-loop on PATH" >&2
echo "ds-loop: install the package (npm i -g ds-loop) or symlink this skill from inside it" >&2
exit 1
