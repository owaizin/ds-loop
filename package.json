{
  "name": "ds-loop",
  "version": "0.1.2",
  "description": "Design System Loop — deterministic design-system checks for supported CSS and Tailwind code, with source locations and stated coverage limits.",
  "type": "module",
  "bin": {
    "ds-loop": "bin/ds-loop.mjs"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["bin", "dist", "skill", "README.md", "LICENSE", "docs/guide"],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ds-loop": "node --experimental-strip-types src/cli.ts",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["design-system", "design-tokens", "storybook", "audit", "governance", "ciede2000"],
  "license": "MIT",
  "author": "owaizin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owaizin/ds-loop.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
